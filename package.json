{
  "name": "monotube",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "MonoTube — YouTube. Nothing Else. A distraction-free YouTube browser extension (Chrome/Edge, Manifest V3).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
